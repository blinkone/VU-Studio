<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>VuStudio.Rendering</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VuStudio.Core\VuStudio.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fonts, icons and other static assets are embedded so the service never depends on its working directory. -->
    <EmbeddedResource Include="Assets\**\*" Exclude="Assets\**\*.md" LogicalName="VuStudio.Rendering.Assets/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VuStudio.Tests" />
  </ItemGroup>
</Project>
